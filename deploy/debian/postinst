#!/bin/sh
set -e

# visudo validates the installed file's path against its own name, so
# check it staged under /etc/sudoers.d rather than in the unpacked tree.
SUDOERS=/etc/sudoers.d/homie-deploy

case "$1" in
    configure)
        if ! visudo -cf "$SUDOERS" >/dev/null 2>&1; then
            echo "homie: $SUDOERS failed validation, removing it" >&2
            rm -f "$SUDOERS"
        fi

        if ! getent passwd homie >/dev/null; then
            echo "homie: user 'homie' does not exist; the service will not start" >&2
        fi

        # Avahi publishes the system hostname, so naming the device is what
        # makes it reachable at homie.local. Only on a first install ($2 is
        # the previously configured version): re-running it on every upgrade
        # would quietly undo a deliberate rename.
        if [ -z "$2" ]; then
            hostnamectl set-hostname homie 2>/dev/null || echo homie > /etc/hostname
            # hostnamectl leaves /etc/hosts alone, and a 127.0.1.1 line still
            # naming the old host makes sudo warn on every call.
            if grep -q '^127\.0\.1\.1' /etc/hosts; then
                sed -i 's/^127\.0\.1\.1.*/127.0.1.1\thomie/' /etc/hosts
            else
                printf '127.0.1.1\thomie\n' >> /etc/hosts
            fi
            systemctl try-restart avahi-daemon.service || true
        fi

        mkdir -p /etc/homie
        if [ -f /opt/homie/api.env ] && [ ! -f /etc/homie/api.env ]; then
            mv /opt/homie/api.env /etc/homie/api.env
        fi
        if [ ! -f /etc/homie/kiosk.env ]; then
            echo "HOMIE_KIOSK_URL=http://localhost:3001" > /etc/homie/kiosk.env
        fi
        chgrp homie /etc/homie/*.env 2>/dev/null || true
        chmod 0664 /etc/homie/*.env 2>/dev/null || true

        mkdir -p /var/cache/homie
        chown root:homie /var/cache/homie
        chmod 0770 /var/cache/homie

        systemctl daemon-reload
        systemctl enable homie-api.service homie-kiosk.service homie-emoji-font.service
        systemctl restart homie-api.service
        systemctl restart homie-kiosk.service
        # --no-block because this downloads 116 MB of font on a first install,
        # and an upgrade should not sit waiting for it. The unit restarts the
        # kiosk itself once the font is in place.
        systemctl start --no-block homie-emoji-font.service
        # The timer picks the download back up if that attempt fails.
        systemctl enable --now homie-emoji-font.timer
        ;;
esac

exit 0
