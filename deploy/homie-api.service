[Unit]
Description=Homie API
After=network-online.target homie-api.socket
Wants=network-online.target
Requires=homie-api.socket

[Service]
Type=notify
ExecStart=/usr/bin/homie-api
Environment=HOMIE_LOCAL_ADDR=127.0.0.1:3001
EnvironmentFile=-/etc/homie/api.env
WatchdogSec=30s
Restart=always
RestartSec=2

StateDirectory=homie
WorkingDirectory=/var/lib/homie
User=homie
Group=homie
SupplementaryGroups=i2c
DeviceAllow=char-i2c rw

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
