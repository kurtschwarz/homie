[Unit]
Description=Homie Kiosk
After=homie-api.service getty@tty1.service
Wants=homie-api.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=homie
Group=homie
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

# Core environment configuration
EnvironmentFile=-/opt/homie/kiosk.env
Environment=HOMIE_KIOSK_URL=http://localhost:3000
Environment=HOMIE_KIOSK_EXTRA_FLAGS=

# Cursor Configuration (Your custom transparent theme assets)
Environment=XCURSOR_PATH=/opt/homie/cursors
Environment=XCURSOR_THEME=homie-blank

# FIX: Explicitly pass runtime directory context variables so Cage can read assets
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_DATA_DIRS=/usr/local/share:/usr/share

ExecStart=/bin/sh -c 'exec cage -- chromium \
  --kiosk "$HOMIE_KIOSK_URL" \
  --ozone-platform=wayland \
  --noerrdialogs \
  --no-first-run \
  --no-default-browser-check \
  --disable-search-engine-choice-screen \
  --password-store=basic \
  --force-device-scale-factor=1 \
  --disable-pinch \
  --disable-session-crashed-bubble \
  --disable-background-timer-throttling \
  --disable-renderer-backgrounding \
  --disable-backgrounding-occluded-windows \
  --hide-scrollbars \
  --disable-features=TranslateUI,PrivacySandboxSettings4,PrivacySandboxAdsAPIs,MediaRouter,DialMediaRouteProvider,OptimizationHints \
  --autoplay-policy=no-user-gesture-required \
  $HOMIE_KIOSK_EXTRA_FLAGS'

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
