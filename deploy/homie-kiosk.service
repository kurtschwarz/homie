[Unit]
Description=Homie Kiosk
After=homie-api.service getty@tty1.service
Wants=homie-api.service
Conflicts=getty@tty1.service

[Service]
Type=simple
EnvironmentFile=-/opt/homie/kiosk.env
Environment=HOMIE_KIOSK_URL=http://localhost:3000
Environment=HOMIE_KIOSK_EXTRA_FLAGS=
ExecStart=/bin/sh -c 'exec cage -- chromium \
  --kiosk "$HOMIE_KIOSK_URL" \
  --ozone-platform=wayland \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=TranslateUI \
  --check-for-update-interval=31536000 \
  --autoplay-policy=no-user-gesture-required \
  $HOMIE_KIOSK_EXTRA_FLAGS'
Restart=always
RestartSec=2

User=homie
Group=homie
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
