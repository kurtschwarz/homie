# Dev-only image: live-reloads the Go API on source changes via air.
# Not used for the Pi build — see Dockerfile for the production image.
FROM golang:1.26-bookworm

RUN go install github.com/air-verse/air@latest

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 3000
CMD ["air", "-c", ".air.toml"]
