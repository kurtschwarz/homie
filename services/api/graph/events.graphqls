type Person {
  id: ID!
  name: String!
  emoji: String!
  swatch: String!
  isFamily: Boolean!
}

type Event {
  id: ID!
  title: String!
  location: String
  start: Int!
  end: Int!
  allDay: Boolean!
  people: [Person!]!
}

enum TagKind {
  PERSON
  INCLUDE
}

type TagMapping {
  tag: String!
  label: String!
  kind: TagKind!
  person: Person
}

input PersonInput {
  id: ID
  name: String!
  emoji: String!
  swatch: String!
  isFamily: Boolean!
}

input TagMappingInput {
  tag: String!
  kind: TagKind!
  personId: ID
}

input EventInput {
  title: String!
  location: String
  start: Int!
  end: Int!
  allDay: Boolean!
  personIds: [ID!]!
}

extend type Query {
  events(days: Int = 21): [Event!]!
  people: [Person!]!
  tagMappings: [TagMapping!]!
  calendarTags: [String!]!
}

extend type Mutation {
  createEvent(input: EventInput!): Event!
  savePerson(input: PersonInput!): Person!
  deletePerson(id: ID!): Boolean!
  saveTagMapping(input: TagMappingInput!): TagMapping!
  deleteTagMapping(tag: String!): Boolean!
  """
  Syncs the calendar window from CalDAV and waits for it to finish. This runs
  the refresh inline rather than enqueuing the periodic job, whose uniqueness
  window would swallow a manual request made soon after a scheduled one.
  """
  refreshEvents: Boolean!
}
