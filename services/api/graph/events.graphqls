type Person {
  id: ID!
  name: String!
  emoji: String!
  swatch: String!
  isFamily: Boolean!
}

type Event {
  id: ID!
  calendarId: ID!
  title: String!
  location: String
  start: Int!
  end: Int!
  allDay: Boolean!
  people: [Person!]!
}

enum TagKind {
  PERSON
  INCLUDE
}

type TagMapping {
  calendarId: ID!
  tag: String!
  label: String!
  kind: TagKind!
  person: Person
}

input PersonInput {
  id: ID
  name: String!
  emoji: String!
  swatch: String!
  isFamily: Boolean!
}

input TagMappingInput {
  calendarId: ID!
  tag: String!
  kind: TagKind!
  personId: ID
}

input EventInput {
  calendarId: ID!
  title: String!
  location: String
  start: Int!
  end: Int!
  allDay: Boolean!
  personIds: [ID!]!
}

extend type Query {
  events(days: Int = 21): [Event!]! @protected(kinds: [USER, DISPLAY])
  people: [Person!]! @protected
  tagMappings(calendarId: ID!): [TagMapping!]! @protected
  calendarTags(calendarId: ID!): [String!]! @protected
}

extend type Mutation {
  createEvent(input: EventInput!): Event! @protected
  savePerson(input: PersonInput!): Person! @protected
  deletePerson(id: ID!): Boolean! @protected
  saveTagMapping(input: TagMappingInput!): TagMapping! @protected
  deleteTagMapping(calendarId: ID!, tag: String!): Boolean! @protected
  """
  Syncs the calendar window from CalDAV and waits for it to finish. This runs
  the refresh inline rather than enqueuing the periodic job, whose uniqueness
  window would swallow a manual request made soon after a scheduled one.
  """
  refreshEvents: Boolean! @protected
}
