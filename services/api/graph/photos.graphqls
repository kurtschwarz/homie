type Coordinate {
    latitude: Float!
    longitude: Float!
}

"""
A normalized region of interest, with top-left origin.
"""
type FocalRegion {
    x: Float!
    y: Float!
    width: Float!
    height: Float!
}

input FocalRegionInput {
    x: Float!
    y: Float!
    width: Float!
    height: Float!
    source: String!
}

"""
The person credited with a drawing.
"""
type Artist {
    id: ID!
    name: String!
}

type Photo {
    id: ID!
    url: String!
    width: Int!
    height: Int!
    takenAt: Int!
    coordinate: Coordinate
    place: String
    focus: FocalRegion
    artist: Artist
}

enum PhotoShowingSource {
    SCHEDULE
    TAP
}

type PhotoShowing {
    id: ID!
    photo: Photo!
    startedAt: Int!
    endsAt: Int!
    endedAt: Int
    source: PhotoShowingSource!
}

type PhotoShowingState {
    current: PhotoShowing
    next: PhotoShowing
}

"""
Metadata accompanying a photo upload.
"""
input PhotoUploadInput {
    assetID: ID!
    version: String!
    takenAt: Int!
    width: Int!
    height: Int!
    latitude: Float
    longitude: Float
    place: String
    focus: FocalRegionInput
}

"""
Metadata accompanying a saved drawing.
"""
input DrawingInput {
    width: Int!
    height: Int!
    drawnAt: Int!
    artistId: ID
}

scalar Upload

extend type Query {
    photos(limit: Int = 60): [Photo!]! @protected(kinds: [USER, DISPLAY])
    photoShowing: PhotoShowingState! @protected(kinds: [USER, DISPLAY])
    photoShowingHistory(limit: Int = 50): [PhotoShowing!]! @protected

    """
    Drawings not yet pushed to Photos, oldest first. Photo Sync only.
    """
    unpushedDrawings: [Photo!]! @protected(kinds: [USER])

    """
    Photos asset identifiers Homie already knows are pushed drawings, so
    Photo Sync does not upload them back as ordinary photos.
    """
    pushedDrawingAssetIDs: [String!]! @protected(kinds: [USER])
}

type Mutation {
    """
    Imports an Apple photo from Photo Sync, keeping the same id across
    re-uploads of a known asset. JPEG only.
    """
    uploadPhoto(input: PhotoUploadInput!, file: Upload!): Photo! @protected

    """
    Records that the display moved to the next photo, and returns the updated
    rotation.
    """
    trackPhotoShowing(
        source: PhotoShowingSource! = SCHEDULE
    ): PhotoShowingState! @protected(kinds: [USER, DISPLAY])

    """
    Saves a drawing from the display as a new photo of kind DRAWING. JPEG
    only, display only. The drawing has no focal region or coordinate, and its
    drawn-at time becomes its taken-at time.
    """
    saveDrawing(input: DrawingInput!, file: Upload!): Photo!
        @protected(kinds: [DISPLAY])

    """
    Records the Photos asset created for a drawing. Safe to repeat: the first
    recorded asset is kept. Fails for an unknown drawing id.
    """
    markDrawingPushed(id: ID!, assetID: ID!): Boolean!
        @protected(kinds: [USER])
}
