type Coordinate {
  latitude: Float!
  longitude: Float!
}

"""A normalized region of interest, with top-left origin."""
type FocalRegion {
  x: Float!
  y: Float!
  width: Float!
  height: Float!
}

input FocalRegionInput {
  x: Float!
  y: Float!
  width: Float!
  height: Float!
  source: String!
}

type Photo {
  id: ID!
  url: String!
  width: Int!
  height: Int!
  takenAt: Int!
  coordinate: Coordinate
  place: String
  focus: FocalRegion
}

"""Metadata accompanying a photo upload."""
input PhotoUploadInput {
  assetID: ID!
  version: String!
  takenAt: Int!
  width: Int!
  height: Int!
  latitude: Float
  longitude: Float
  place: String
  focus: FocalRegionInput
}

scalar Upload

extend type Query {
  photos(limit: Int = 60): [Photo!]!
}

type Mutation {
  uploadPhoto(input: PhotoUploadInput!, file: Upload!): Photo!
}
